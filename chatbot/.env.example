# LLM API Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# LLM Models
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_MODEL=deepseek/deepseek-chat

# Ollama (Local LLM fallback - optional)
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# MongoDB
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/media-octus-crm
MONGO_URI=mongodb://localhost:27017/media-octus-crm

# MySQL (Optional / Legacy)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=media_octus

# Chatbot Server Port
PORT=8000
