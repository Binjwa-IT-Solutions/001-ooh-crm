# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# Browser GPS change thresholds. GPS is requested once when the user signs in;
# it is not tracked continuously.
LOCATION_CHANGE_RADIUS_METERS=1000
LOCATION_MAX_ACCURACY_METERS=1000

# Office areas. When set, an approved device reporting an accurate location outside
# every office needs admin approval. New devices always need approval. JSON array;
# radiusMeters >= 100. Leave empty to compare against each device's first location
# instead. Find coordinates by right-clicking the office in Google Maps.
# OFFICE_LOCATIONS=[{"name":"Mumbai HQ","lat":19.0760,"lng":72.8777,"radiusMeters":300}]
OFFICE_LOCATIONS=

# false: a login with no/inaccurate browser location only alerts admins.
# true: it waits for approval (blocks devices that cannot report an accurate fix).
LOCATION_REQUIRED=false
NODE_ENV=development

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Run Mongo as a single-node replica set — transactions do not work on a
# standalone mongod, and bookings/payments/payroll need them.

MONGO_URI=mongodb://localhost:27017/media-octus-crm

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate your own:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# 32-byte AES key as 64 hexadecimal characters; required in production.
# A development-only fallback is provided when NODE_ENV is not production.
MFA_ENCRYPTION_KEY=

# ─── Login OTP (second factor) ───────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# console = print the code to the server log (local development)
# email   = send through the Resend API over HTTPS
OTP_DELIVERY=console

# DEVELOPMENT ONLY. Returns the OTP in the /api/auth/login response so the login
# screen can show it. Ignored entirely when NODE_ENV=production.
OTP_EXPOSE_IN_RESPONSE=true

# ─── Email provider ──────────────────────────────────────────────────────────
# Verify the sender domain in Resend, then use an address on that domain.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Media Octus CRM <no-reply@your-verified-domain.com>

# ─── File storage (proof photos, documents) ──────────────────────────────────
# local = a folder on disk (development only)
# s3    = Cloudflare R2 / Backblaze B2 — not implemented yet, see core/files/s3-adapter.ts
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
MAX_UPLOAD_MB=15

# Where this API is reachable. Used to build URLs for locally stored files.
PUBLIC_BASE_URL=http://localhost:5000

# Only needed when STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Off locally so seven developers do not each fire the nightly rollups.
# On in staging and production.
JOBS_ENABLED=false
JOBS_TIMEZONE=Asia/Kolkata

# ─── Audit log ───────────────────────────────────────────────────────────────
# Records every successful create/update/delete automatically. Turn off only
# for a specific debugging session, never in a deployed environment.
AUDIT_ENABLED=true

# ─── Python AI Chatbot Service ───────────────────────────────────────────────
# URL and timeout of the internal Python Flask/FastAPI assistant service.
PYTHON_CHATBOT_URL=http://127.0.0.1:8000
PYTHON_CHATBOT_TIMEOUT_MS=60000

