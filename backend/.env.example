# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# ─── Database ────────────────────────────────────────────────────────────────
# Run Mongo as a single-node replica set — transactions do not work on a
# standalone mongod, and bookings/payments/payroll need them.

MONGO_URI=mongodb+srv://tarunbinjwaitsolutions_db_user:vek80PWMDPw8WeFV@cluster0.fz5winu.mongodb.net/media-octus-crm
# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate your own:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ─── Login OTP (second factor) ───────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# console = print the code to the server log (no email account needed — use this locally)
# email   = send through the provider below (not implemented yet, see core/notifications)
OTP_DELIVERY=console

# DEVELOPMENT ONLY. Returns the OTP in the /api/auth/login response so the login
# screen can show it. Ignored entirely when NODE_ENV=production.
OTP_EXPOSE_IN_RESPONSE=true

# ─── Email provider (Phase 2 — real MFA) ─────────────────────────────────────
# Use Resend / SES / Postmark with a verified domain. Never VPS SMTP: OTP mail
# lands in spam and blocks logins.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=Media Octus CRM <no-reply@example.com>

# ─── File storage (proof photos, documents) ──────────────────────────────────
# local = a folder on disk (development only)
# s3    = Cloudflare R2 / Backblaze B2 — not implemented yet, see core/files/s3-adapter.ts
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
MAX_UPLOAD_MB=15

# Where this API is reachable. Used to build URLs for locally stored files.
PUBLIC_BASE_URL=http://localhost:5000

# Only needed when STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Off locally so seven developers do not each fire the nightly rollups.
# On in staging and production.
JOBS_ENABLED=false
JOBS_TIMEZONE=Asia/Kolkata

# ─── Audit log ───────────────────────────────────────────────────────────────
# Records every successful create/update/delete automatically. Turn off only
# for a specific debugging session, never in a deployed environment.
AUDIT_ENABLED=true
